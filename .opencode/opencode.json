{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "filesystem-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/config/workspace/lottery-codex"
      ]
    }
  },
  "playwright-mcp": {
    "enabled": true,
    "type": "local",
    "command": [
      "npx",
      "-y",
      "@playwright/mcp@latest"
    ]
  },
  "tools": {
    "playwright-mcp_*": false
  }
}