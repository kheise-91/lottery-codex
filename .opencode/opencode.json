{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "filesystem-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/config/workspace/lottery-codex"
      ]
    },
    "gitea-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "gitea-mcp",
        "-t", "stdio",
        "-H", "http://gitea:3000",
        "-T", "77b3ff5fb8565ca8f2472cc4b1a07d6c5b570fee"
      ]
    },
    "playwright-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--no-sandbox"
      ]
    }
  },
  "tools": {
    "gitea-mcp_*": false,
    "playwright-mcp_*": false
  }
}